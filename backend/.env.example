# Thoth backend — copy to .env (local) or export on the host (compose).
# Local dev (native Postgres):
DATABASE_URL=postgres://thoth:thoth@localhost:5432/thoth
PORT=4000

# Docker compose (db service):
POSTGRES_USER=thoth
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_DB=thoth

# API / worker tuning (all optional, defaults shown):
# CORS_ORIGIN=*
# REQUESTS_PER_MIN=120
# POLL_JITTER_PCT=10
# TELEGRAM_CHANNELS=osintdefender,war_monitor,aljazeeraenglish
# OSIRIS_PORT=4000
# LOG_LEVEL=info

# Optional depth keys (backend works without):
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
