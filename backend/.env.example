# Thoth backend — copy to .env (local) or export on the host (compose).
# Full reference: docs/PRODUCTION.md §2. Every value is validated at boot.

# --- Local dev (native Postgres) ---
DATABASE_URL=postgres://thoth:thoth@localhost:5432/thoth
PORT=4000
# NODE_ENV=development   # production: DATABASE_URL required, writes need API_WRITE_KEY

# --- Docker compose (required there) ---
POSTGRES_USER=thoth
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_DB=thoth
# Shared secret for POST/PUT/PATCH/DELETE on /api (Bearer or X-Thoth-Key).
# Unset in dev = writes open; unset in production = writes refused.
API_WRITE_KEY=change-me-generate-with-openssl-rand-hex-32
# App gate (pick one when exposed): user:pass Basic auth, or trust an SSO proxy.
# APP_BASIC_AUTH=ops:change-me
# APP_TRUST_UPSTREAM_AUTH=1

# --- API / worker tuning (optional, defaults shown) ---
# CORS_ORIGIN=*                                   # or https://a.example,https://b.example
# TRUST_PROXY=loopback, linklocal, uniquelocal    # hops allowed to set X-Forwarded-For
# REQUESTS_PER_MIN=120                            # per client IP
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=60000
# SSE_MAX_CLIENTS=500
# POLL_JITTER_PCT=10
# TELEGRAM_CHANNELS=osintdefender,war_monitor,aljazeeraenglish
# LOG_LEVEL=info
# API_PORT=4000        # compose host port (bound to 127.0.0.1)
# APP_PORT=3000        # compose host port
# APP_BIND=127.0.0.1   # 0.0.0.0 only if the app listens publicly itself

# --- Optional depth keys (backend works without; disabled-honest) ---
# OTX_API_KEY=
# FINNHUB_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
